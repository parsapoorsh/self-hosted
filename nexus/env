# Nexus Repository constants (admin password from root .env).
NEXUS_CONTEXT_PATH=/
NEXUS_RUT_HEADER=X-Remote-User
NEXUS_ADMIN_USER=admin
# Skip sample repos; allow Groovy for Rut Auth bootstrap; modest heap.
INSTALL4J_ADD_VM_PARAMS=-Xms512m -Xmx1536m -XX:MaxDirectMemorySize=2g -Dnexus.skipDefaultRepositories=true -Dnexus.scripts.allowCreation=true -Djava.util.prefs.userRoot=/nexus-data/javaprefs

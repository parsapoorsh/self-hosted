# Nexus Repository constants (admin password from root .env).
NEXUS_CONTEXT_PATH=/
NEXUS_RUT_HEADER=X-Remote-User
NEXUS_ADMIN_USER=admin
# Skip sample repos; allow Groovy for Rut Auth bootstrap; modest heap.
# upload.url points base telemetry at the loopback sink; loader.path shadows
# CE usage-limit classes with the patched copies built by docker-entrypoint.sh.
INSTALL4J_ADD_VM_PARAMS=-Xms512m -Xmx1536m -XX:MaxDirectMemorySize=2g -Dnexus.skipDefaultRepositories=true -Dnexus.scripts.allowCreation=true -Djava.util.prefs.userRoot=/nexus-data/javaprefs -Dnexus.analytics.upload.url=http://127.0.0.1:8099/production/oss/ingest -Dloader.path=/nexus-data/patch/nexus-content-usage-patch.jar

# oauth2-proxy constants for https://nexus.localhost/ (client/cookie secrets from .env.secrets).
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_SKIP_OIDC_DISCOVERY=true
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_UPSTREAMS=static://202
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_CODE_CHALLENGE_METHOD=S256
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
OAUTH2_PROXY_OIDC_EMAIL_CLAIM=email
OAUTH2_PROXY_USER_ID_CLAIM=preferred_username
OAUTH2_PROXY_COOKIE_NAME=_nexus_oauth2_local
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_CSRF_PER_REQUEST=true
OAUTH2_PROXY_COOKIE_CSRF_EXPIRE=5m
OAUTH2_PROXY_WHITELIST_DOMAINS=.localhost,localhost
OAUTH2_PROXY_SCOPE=openid email profile
OAUTH2_PROXY_SSL_INSECURE_SKIP_VERIFY=true
OAUTH2_PROXY_CLIENT_ID=nexus
# HTTPS localhost (Secure cookies).
OAUTH2_PROXY_OIDC_ISSUER_URL=https://auth.localhost
OAUTH2_PROXY_LOGIN_URL=https://auth.localhost/api/oidc/authorization
OAUTH2_PROXY_REDIRECT_URL=https://nexus.localhost/oauth2/callback
# Via nginx TLS edge (Authelia 4.39+ needs X-Forwarded-Proto=https on token).
OAUTH2_PROXY_REDEEM_URL=https://auth.localhost/api/oidc/token
OAUTH2_PROXY_OIDC_JWKS_URL=https://auth.localhost/jwks.json
OAUTH2_PROXY_PROFILE_URL=https://auth.localhost/api/oidc/userinfo

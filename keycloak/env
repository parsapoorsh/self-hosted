# Keycloak constants (human admin + secrets from root .env / .env.secrets).
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=keycloak
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
# Frontend host from X-Forwarded-Host (auth.<DOMAIN> and auth.localhost).
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_BACKCHANNEL_DYNAMIC=false
KC_HEALTH_ENABLED=true
# Lax: avoid Secure+SameSite=None cookies that browsers drop on plain HTTP.
KC_SPI_COOKIE_DEFAULT_SAME_SITE=Lax
# First-boot temporary admin only; bootstrap promotes KEYCLOAK_ADMIN to permanent.
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KEYCLOAK_REALM=home
OIDC_CLIENT_ID=nextcloud
NEXUS_OIDC_CLIENT_ID=nexus

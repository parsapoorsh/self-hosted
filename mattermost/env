# Mattermost constants (secrets and SiteURL from compose / .env.secrets).
# Image runs as uid 2000; named volumes are chowned on first start by the entrypoint.
TZ=UTC
MM_SQLSETTINGS_DRIVERNAME=postgres
MM_BLEVESETTINGS_INDEXDIR=/mattermost/bleve-indexes

# GitLab SSO pointed at Authelia (see Authelia Mattermost OIDC docs).
MM_GITLABSETTINGS_ENABLE=true
MM_GITLABSETTINGS_BUTTONTEXT=Log in with Authelia
MM_GITLABSETTINGS_BUTTONCOLOR=#000000
# openid switches MM enterprise to OpenID provider (uses preferred_username).
# Skip profile so Authelia does not send preferred_username=admin; mattermost
# scope supplies preferred_username/username as sysadmin via claims_policy.
MM_GITLABSETTINGS_SCOPE=openid email mattermost

# Authelia-only auth: no local email/username create-account or password login.
# EnableUserCreation stays true so first Authelia login can create the MM user.
MM_SERVICESETTINGS_ENABLESECURITYFIXALERT=false
MM_EMAILSETTINGS_ENABLESIGNUPWITHEMAIL=false
MM_EMAILSETTINGS_ENABLESIGNINWITHEMAIL=false
MM_EMAILSETTINGS_ENABLESIGNINWITHUSERNAME=false
MM_EMAILSETTINGS_SENDEMAILNOTIFICATIONS=false
MM_EMAILSETTINGS_REQUIREEMAILVERIFICATION=false
MM_EMAILSETTINGS_ENABLESMTPAUTH=false
MM_TEAMSETTINGS_ENABLEOPENSERVER=true
MM_TEAMSETTINGS_ENABLEUSERCREATION=true
# Skip "Where would you like to view this?" (desktop app vs browser); open in browser.
MM_SERVICESETTINGS_ENABLEDESKTOPLANDINGPAGE=false

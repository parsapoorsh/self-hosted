# Nexspence constants (admin, DB DSN, OIDC secrets/URLs from compose).
NEXSPENCE_HTTP_ADDR=:8081
NEXSPENCE_LOG_LEVEL=info
NEXSPENCE_LOG_FORMAT=json
NEXSPENCE_STORAGE_DEFAULT_TYPE=local
NEXSPENCE_STORAGE_LOCAL_BASE_PATH=/app/data/blobs
NEXSPENCE_AUTH_ANONYMOUS_ENABLED=true
# nginx is the only client-facing hop on the Docker network.
NEXSPENCE_HTTP_TRUSTED_PROXIES=*
# Image scanning off unless an operator mounts Trivy.
NEXSPENCE_SCAN_TRIVY_ENABLED=false

# Authelia OIDC (issuer / redirect / client secret from compose).
NEXSPENCE_OIDC_ENABLED=true
NEXSPENCE_OIDC_DISPLAY_NAME=Authelia
NEXSPENCE_OIDC_COOKIE_SECURE=true
NEXSPENCE_OIDC_ADMIN_GROUP=admins
NEXSPENCE_OIDC_GROUPS_CLAIM=groups
NEXSPENCE_OIDC_PROVISIONING=jit
NEXSPENCE_OIDC_SCOPES=openid,profile,email,groups

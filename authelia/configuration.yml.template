---
# Rendered at container start by docker-entrypoint.sh (placeholders only).
# auth.localhost cookie + ACL: intentional dual IdP host with auth.__DOMAIN__
# so local TLS (*.localhost) and public DOMAIN share one Authelia.
theme: auto
log:
  level: info
  format: text

server:
  address: 'tcp://0.0.0.0:9091/'

telemetry:
  metrics:
    enabled: false

totp:
  disable: true

webauthn:
  disable: true

authentication_backend:
  password_reset:
    disable: true
  refresh_interval: '5m'
  file:
    path: /data/users_database.yml

access_control:
  default_policy: deny
  rules:
    - domain: 'auth.__DOMAIN__'
      policy: bypass
    - domain: 'auth.localhost'
      policy: bypass

session:
  secret: '__SESSION_SECRET__'
  cookies:
    # Cookie domain is the IdP host (OIDC only; not forward-auth on other apps).
    - name: authelia_session
      domain: 'auth.__DOMAIN__'
      authelia_url: 'https://auth.__DOMAIN__'
      default_redirection_url: 'https://auth.__DOMAIN__/'
      same_site: lax
    - name: authelia_session
      domain: 'auth.localhost'
      authelia_url: 'https://auth.localhost'
      default_redirection_url: 'https://auth.localhost/'
      same_site: lax

regulation:
  max_retries: 8
  find_time: '2m'
  ban_time: '5m'

storage:
  encryption_key: '__STORAGE_ENCRYPTION_KEY__'
  postgres:
    address: 'tcp://postgres:5432'
    database: 'authelia'
    username: 'authelia'
    password: '__AUTHELIA_DB_PASSWORD__'
    timeout: '5s'

notifier:
  disable_startup_check: true
  filesystem:
    filename: /data/notification.txt

identity_providers:
  oidc:
    hmac_secret: '__OIDC_HMAC_SECRET__'
    jwks:
      - key_id: 'authelia'
        algorithm: 'RS256'
        use: 'sig'
        key: |
__JWKS_PEM__
    cors:
      endpoints:
        - authorization
        - token
        - revocation
        - introspection
        - userinfo
      allowed_origins_from_client_redirect_uris: true
    # Mattermost GitLab SSO expects a top-level "username" claim.
    claims_policies:
      mattermost:
        custom_claims:
          username:
            name: 'username'
            attribute: 'username'
    scopes:
      mattermost:
        claims:
          - 'username'
    clients:
      - client_id: '__OIDC_CLIENT_ID__'
        client_name: 'Nextcloud'
        client_secret: '__OIDC_CLIENT_SECRET_HASH__'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        pre_configured_consent_duration: '1y'
        require_pkce: false
        pkce_challenge_method: 'S256'
        redirect_uris:
          - 'https://cloud.__DOMAIN__/apps/user_oidc/code'
          - 'http://cloud.__DOMAIN__/apps/user_oidc/code'
          - 'https://cloud.localhost/apps/user_oidc/code'
          - 'https://cloud.__DOMAIN__/index.php/apps/user_oidc/code'
          - 'http://cloud.__DOMAIN__/index.php/apps/user_oidc/code'
          - 'https://cloud.localhost/index.php/apps/user_oidc/code'
        scopes:
          - openid
          - profile
          - email
          - groups
        response_types:
          - code
        grant_types:
          - authorization_code
        token_endpoint_auth_method: client_secret_basic
        userinfo_signed_response_alg: none
      - client_id: '__NEXUS_OIDC_CLIENT_ID__'
        client_name: 'Nexus'
        client_secret: '__NEXUS_OIDC_CLIENT_SECRET_HASH__'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        pre_configured_consent_duration: '1y'
        require_pkce: true
        pkce_challenge_method: 'S256'
        redirect_uris:
          - 'https://nexus.__DOMAIN__/oauth2/callback'
          - 'http://nexus.__DOMAIN__/oauth2/callback'
          - 'https://nexus.localhost/oauth2/callback'
        scopes:
          - openid
          - profile
          - email
          - groups
        response_types:
          - code
        grant_types:
          - authorization_code
        token_endpoint_auth_method: client_secret_basic
        userinfo_signed_response_alg: none
      - client_id: '__MATTERMOST_OIDC_CLIENT_ID__'
        client_name: 'Mattermost'
        client_secret: '__MATTERMOST_OIDC_CLIENT_SECRET_HASH__'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        pre_configured_consent_duration: '1y'
        claims_policy: 'mattermost'
        require_pkce: false
        redirect_uris:
          - 'https://mattermost.__DOMAIN__/signup/gitlab/complete'
          - 'http://mattermost.__DOMAIN__/signup/gitlab/complete'
          - 'https://mattermost.localhost/signup/gitlab/complete'
          - 'https://mattermost.__DOMAIN__/login/gitlab/complete'
          - 'http://mattermost.__DOMAIN__/login/gitlab/complete'
          - 'https://mattermost.localhost/login/gitlab/complete'
        scopes:
          - openid
          - mattermost
        response_types:
          - code
        grant_types:
          - authorization_code
        token_endpoint_auth_method: client_secret_post
        userinfo_signed_response_alg: none

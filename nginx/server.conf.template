# Domain injected at start (__DOMAIN__ -> DOMAIN).
# *.localhost is always served too (local browser) alongside DOMAIN.
#
# Localhost uses HTTPS (cert/localhost): Keycloak sets Secure cookies, which
# browsers drop on plain HTTP. HTTP *.localhost redirects to HTTPS.
#
# Edge:
#   ONE Anubis vhost for protected hosts (add names here when needed)
#   Separate vhosts only for Anubis bypass (OIDC / sync clients)
# Backend (:8080, Anubis TARGET): one server per app
#
# TLS: cert/<domain|localhost>/{fullchain,privkey}.pem via $edge_cert_dir map

# --- HTTP -> HTTPS for localhost names (Secure cookies / SSO) ---
server {
    listen 80;
    server_name localhost www.localhost
                auth.localhost cloud.localhost nexus.localhost kiwix.localhost;
    return 301 https://$host$request_uri;
}

# --- edge: Anubis (default) — DOMAIN on :80; DOMAIN+localhost on :443 ---
server {
    listen 80 default_server;
    server_name __DOMAIN__ www.__DOMAIN__ kiwix.__DOMAIN__;

    include /etc/nginx/self-hosted/cloudflare.conf;
    include /etc/nginx/self-hosted/snippets/anubis-proxy.conf;
}

server {
    listen 443 ssl default_server;
    server_name __DOMAIN__ www.__DOMAIN__ kiwix.__DOMAIN__
                localhost www.localhost kiwix.localhost;

    include /etc/nginx/self-hosted/snippets/edge-tls.conf;
    include /etc/nginx/self-hosted/cloudflare.conf;
    include /etc/nginx/self-hosted/snippets/anubis-proxy.conf;
}

# --- edge: auth (Anubis bypass) ---
server {
    listen 80;
    server_name auth.__DOMAIN__;

    include /etc/nginx/self-hosted/cloudflare.conf;

    location / {
        set $keycloak_upstream http://keycloak:8080;
        proxy_pass $keycloak_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
        proxy_read_timeout 60s;
    }
}

server {
    listen 443 ssl;
    server_name auth.__DOMAIN__ auth.localhost;

    include /etc/nginx/self-hosted/snippets/edge-tls.conf;
    include /etc/nginx/self-hosted/cloudflare.conf;

    location / {
        set $keycloak_upstream http://keycloak:8080;
        proxy_pass $keycloak_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
        proxy_read_timeout 60s;
    }
}

# --- edge: cloud / Nextcloud (Anubis bypass) ---
server {
    listen 80;
    server_name cloud.__DOMAIN__;

    include /etc/nginx/self-hosted/cloudflare.conf;

    client_max_body_size 16G;
    include /etc/nginx/self-hosted/nextcloud.conf;
}

server {
    listen 443 ssl;
    server_name cloud.__DOMAIN__ cloud.localhost;

    include /etc/nginx/self-hosted/snippets/edge-tls.conf;
    include /etc/nginx/self-hosted/cloudflare.conf;

    client_max_body_size 16G;
    include /etc/nginx/self-hosted/nextcloud.conf;
}

# --- edge: nexus (Anubis bypass; UI via Keycloak, package APIs use Nexus auth) ---
# HTTP for DOMAIN only; nexus.localhost HTTP is redirected to HTTPS above.
server {
    listen 80;
    server_name nexus.__DOMAIN__;

    include /etc/nginx/self-hosted/cloudflare.conf;

    client_max_body_size 0;
    proxy_request_buffering off;

    location /oauth2/ {
        proxy_pass $nexus_oauth2_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Auth-Request-Redirect $scheme://$host$request_uri;
        proxy_set_header Connection "";
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    location = /oauth2/auth {
        proxy_pass $nexus_oauth2_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Content-Length "";
        proxy_set_header Connection "";
        proxy_pass_request_body off;
        proxy_pass_request_headers on;
    }

    location ~ ^/(repository|v2)/ {
        set $nexus_upstream http://nexus:8081;
        proxy_pass $nexus_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /service/rest/ {
        auth_request /oauth2/auth;
        auth_request_set $auth_user $upstream_http_x_auth_request_preferred_username;
        error_page 401 = @nexus_rest_nosso_http;

        set $nexus_upstream http://nexus:8081;
        proxy_pass $nexus_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Remote-User $auth_user;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location @nexus_rest_nosso_http {
        set $nexus_upstream http://nexus:8081;
        proxy_pass $nexus_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        auth_request /oauth2/auth;
        error_page 401 = @nexus_oidc_signin_http;
        auth_request_set $auth_user $upstream_http_x_auth_request_preferred_username;
        auth_request_set $auth_email $upstream_http_x_auth_request_email;

        set $nexus_upstream http://nexus:8081;
        proxy_pass $nexus_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Remote-User $auth_user;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    location @nexus_oidc_signin_http {
        set $rd_escape $request_uri;
        return 302 /oauth2/start?rd=$scheme://$host$rd_escape;
    }
}

server {
    listen 443 ssl;
    server_name nexus.__DOMAIN__ nexus.localhost;

    include /etc/nginx/self-hosted/snippets/edge-tls.conf;
    include /etc/nginx/self-hosted/cloudflare.conf;

    client_max_body_size 0;
    proxy_request_buffering off;

    # oauth2-proxy (Keycloak OIDC) — host map picks DOMAIN vs localhost instance
    location /oauth2/ {
        proxy_pass $nexus_oauth2_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Auth-Request-Redirect $scheme://$host$request_uri;
        proxy_set_header Connection "";
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    location = /oauth2/auth {
        proxy_pass $nexus_oauth2_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Content-Length "";
        proxy_set_header Connection "";
        proxy_pass_request_body off;
        proxy_pass_request_headers on;
    }

    # Package / Docker registry: Nexus handles basic auth / tokens (no OIDC gate).
    location ~ ^/(repository|v2)/ {
        set $nexus_upstream http://nexus:8081;
        proxy_pass $nexus_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # REST API: attach Rut Auth identity when a Keycloak session exists;
    # otherwise fall through so Maven/curl basic auth still works.
    location /service/rest/ {
        auth_request /oauth2/auth;
        auth_request_set $auth_user $upstream_http_x_auth_request_preferred_username;
        error_page 401 = @nexus_rest_nosso;

        set $nexus_upstream http://nexus:8081;
        proxy_pass $nexus_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Remote-User $auth_user;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location @nexus_rest_nosso {
        set $nexus_upstream http://nexus:8081;
        proxy_pass $nexus_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # UI: require Keycloak session, pass username to Nexus Rut Auth.
    location / {
        auth_request /oauth2/auth;
        error_page 401 = @nexus_oidc_signin;

        # Prefer Keycloak preferred_username (matches Nexus local admin id).
        # X-Auth-Request-User is the subject UUID and would not map to nx-admin.
        auth_request_set $auth_user $upstream_http_x_auth_request_preferred_username;
        auth_request_set $auth_email $upstream_http_x_auth_request_email;

        set $nexus_upstream http://nexus:8081;
        proxy_pass $nexus_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Remote-User $auth_user;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    location @nexus_oidc_signin {
        # Preserve original destination after Keycloak login.
        set $rd_escape $request_uri;
        return 302 /oauth2/start?rd=$scheme://$host$rd_escape;
    }
}

# --- backend: kiwix ---
server {
    listen 8080;
    server_name kiwix.__DOMAIN__ kiwix.localhost;

    include /etc/nginx/self-hosted/snippets/backend-realip.conf;

    location / {
        set $kiwix_upstream http://kiwix-serve:9393;
        proxy_pass $kiwix_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
    }
}

# --- backend: landing ---
server {
    listen 8080 default_server;
    server_name __DOMAIN__ www.__DOMAIN__ localhost www.localhost;

    include /etc/nginx/self-hosted/snippets/backend-realip.conf;

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ =404;
    }
}

# Edge: Mattermost (Anubis bypass).
# SSO via Authelia (GitLabSettings -> OIDC). Public: chat.__DOMAIN__ and chat.localhost

# TEMPORARY: HTTP -> HTTPS for public hosts.
server {
    listen __HTTP_PORT__;
    server_name chat.__DOMAIN__;

    return 302 https://$host__HTTPS_PORT_SUFFIX__$request_uri;
}

server {
    listen __HTTPS_PORT__ ssl;
    server_name chat.__DOMAIN__ chat.localhost;

    include /etc/nginx/self-hosted/snippets/edge-tls.conf;
    include /etc/nginx/self-hosted/cloudflare.conf;
    include /etc/nginx/self-hosted/snippets/mattermost-locations.conf;
}

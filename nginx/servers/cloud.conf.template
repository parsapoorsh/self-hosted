# Edge: Nextcloud (Anubis bypass).
# Public: cloud.__DOMAIN__ and cloud.localhost

# TEMPORARY: HTTP -> HTTPS for public hosts.
server {
    listen __HTTP_PORT__;
    server_name cloud.__DOMAIN__;

    return 302 https://$host__HTTPS_PORT_SUFFIX__$request_uri;
}

server {
    listen __HTTPS_PORT__ ssl;
    server_name cloud.__DOMAIN__ cloud.localhost;

    include /etc/nginx/self-hosted/snippets/edge-tls.conf;
    include /etc/nginx/self-hosted/cloudflare.conf;

    client_max_body_size 16G;
    include /etc/nginx/self-hosted/nextcloud.conf;
}

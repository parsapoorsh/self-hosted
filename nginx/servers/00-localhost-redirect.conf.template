# HTTP -> HTTPS for localhost names (Authelia / oauth2 Secure cookies need TLS).
# Temp redirect only (302). Port suffix empty when HTTPS_PORT is 443.
server {
    listen __HTTP_PORT__;
    server_name localhost www.localhost
                auth.localhost cloud.localhost mirror.localhost library.localhost
                chat.localhost;
    return 302 https://$host__HTTPS_PORT_SUFFIX__$request_uri;
}

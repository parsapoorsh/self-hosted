# Edge: Authelia IdP (Anubis bypass).
# Public: auth.__DOMAIN__ and auth.localhost

# TEMPORARY: HTTP -> HTTPS for public hosts.
server {
    listen 80;
    server_name auth.__DOMAIN__;

    return 302 https://$host__HTTPS_PORT_SUFFIX__$request_uri;
}

server {
    listen __HTTPS_PORT__ ssl;
    server_name auth.__DOMAIN__ auth.localhost;

    include /etc/nginx/self-hosted/snippets/edge-tls.conf;
    include /etc/nginx/self-hosted/cloudflare.conf;
    include /etc/nginx/self-hosted/snippets/authelia-proxy.conf;
}

# Edge: Anubis bot filter (default). Protected hosts only.
# DOMAIN on HTTP_PORT; DOMAIN + localhost on HTTPS_PORT (localhost HTTP redirected elsewhere).

# TEMPORARY: HTTP -> HTTPS for public hosts (remove when plain HTTP is needed again).
server {
    listen __HTTP_PORT__ default_server;
    server_name __DOMAIN__ www.__DOMAIN__ library.__DOMAIN__;

    return 302 https://$host__HTTPS_PORT_SUFFIX__$request_uri;
}

server {
    listen __HTTPS_PORT__ ssl default_server;
    server_name __DOMAIN__ www.__DOMAIN__ library.__DOMAIN__
                localhost www.localhost library.localhost;

    include /etc/nginx/self-hosted/snippets/edge-tls.conf;
    include /etc/nginx/self-hosted/cloudflare.conf;
    include /etc/nginx/self-hosted/snippets/anubis-proxy.conf;
}

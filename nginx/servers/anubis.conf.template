# Edge: Anubis bot filter (default). Protected hosts only.
# DOMAIN on :80; DOMAIN + localhost on :443 (localhost HTTP redirected elsewhere).

server {
    listen 80 default_server;
    server_name __DOMAIN__ www.__DOMAIN__ kiwix.__DOMAIN__;

    include /etc/nginx/self-hosted/cloudflare.conf;
    include /etc/nginx/self-hosted/snippets/anubis-proxy.conf;
}

server {
    listen 443 ssl default_server;
    server_name __DOMAIN__ www.__DOMAIN__ kiwix.__DOMAIN__
                localhost www.localhost kiwix.localhost;

    include /etc/nginx/self-hosted/snippets/edge-tls.conf;
    include /etc/nginx/self-hosted/cloudflare.conf;
    include /etc/nginx/self-hosted/snippets/anubis-proxy.conf;
}

# Edge: Mattermost (Anubis bypass).
# SSO via Authelia (GitLabSettings → OIDC). Public: mattermost.__DOMAIN__ and mattermost.localhost

# TEMPORARY: HTTP -> HTTPS for public hosts.
server {
    listen 80;
    server_name mattermost.__DOMAIN__;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name mattermost.__DOMAIN__ mattermost.localhost;

    include /etc/nginx/self-hosted/snippets/edge-tls.conf;
    include /etc/nginx/self-hosted/cloudflare.conf;
    include /etc/nginx/self-hosted/snippets/mattermost-locations.conf;
}

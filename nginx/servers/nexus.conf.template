# Edge: Nexus Repository (Anubis bypass).
# UI SSO via oauth2-proxy + Rut Auth; package APIs use Nexus basic auth.
# nexus.localhost HTTP -> HTTPS (00-localhost-redirect).

# TEMPORARY: HTTP -> HTTPS for public hosts.
server {
    listen 80;
    server_name nexus.__DOMAIN__;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name nexus.__DOMAIN__ nexus.localhost;

    include /etc/nginx/self-hosted/snippets/edge-tls.conf;
    include /etc/nginx/self-hosted/cloudflare.conf;
    include /etc/nginx/self-hosted/snippets/nexus-locations.conf;
}

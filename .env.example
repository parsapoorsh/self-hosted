# Copy to .env and set values. Then: ./scripts/sync-secrets.sh
# Prefer: ./scripts/compose.sh up -d
#
# One human admin for Authelia, Nextcloud, Mattermost, and Nexspence (OIDC + local API).
# KEYCLOAK_* names kept for compatibility with existing .env files.
# Internal DB/OIDC secrets are derived into gitignored .env.secrets - never commit them.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Apex domain. Subdomains: auth./library./cloud./chat./mirror./www.<DOMAIN>
# Local TLS: ./scripts/gen-localhost-cert.sh && ./scripts/trust-localhost-ca.sh
# Domain cert: ./scripts/self-signed.sh  (or real LE certs under cert/<DOMAIN>/)
DOMAIN=example.com

# Mattermost organization / default team name (also SiteName branding).
ORG_NAME=okbrb

# Postgres superuser (infrastructure only; not an app login).
POSTGRES_PASSWORD=change-me-postgres

# Single app admin (Authelia / Nextcloud / Mattermost SSO / Nexspence)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin

# ---------------------------------------------------------------------------
# Optional - edge ports (nginx published on the host)
# ---------------------------------------------------------------------------
# Defaults 80/443. Non-default values are used in public URLs and OIDC
# redirect URIs (e.g. https://chat.example.com:8443). nginx listens on the
# same ports inside the container so app->auth calls keep working.
#
# HTTP_PORT=80
# HTTPS_PORT=443
#
# Example alternate ports (avoid clashing with another local web stack):
# HTTP_PORT=8080
# HTTPS_PORT=8443

# ---------------------------------------------------------------------------
# Optional - Mattermost Calls (WebRTC)
# Media is UDP/TCP on the host (nginx cannot proxy UDP).
# ./scripts/compose.sh auto-sets CALLS_ICE_HOST_OVERRIDE to the host primary
# IPv4 when unset. Do not use a name that resolves to 127.0.0.1 (local DNS).
# ---------------------------------------------------------------------------

# CALLS_PORT=8443
# CALLS_ICE_HOST_OVERRIDE=192.168.1.4
# CALLS_ICE_HOST_OVERRIDE=203.0.113.10/192.168.1.4

# ---------------------------------------------------------------------------
# Optional - Nextcloud
# ---------------------------------------------------------------------------

# NEXTCLOUD_OVERWRITE_CLI_URL=https://cloud.example.com

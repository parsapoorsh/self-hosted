# Copy to .env and set values. Then: ./scripts/sync-secrets.sh
# Prefer: ./scripts/compose.sh up -d
#
# One human admin for Authelia, Nextcloud, and Nexus (OIDC + local API).
# KEYCLOAK_* names kept for compatibility with existing .env files.
# Internal DB/OIDC secrets are derived into gitignored .env.secrets — never commit them.

# Apex domain. Subdomains: auth./kiwix./cloud./nexus./www.<DOMAIN>
# Local TLS: ./scripts/gen-localhost-cert.sh && ./scripts/trust-localhost-ca.sh
DOMAIN=example.com

# Public URL scheme for OIDC redirects (browser-facing).
# Use https when clients open https://*.DOMAIN (required for Authelia:
# non-localhost http redirect_uris are rejected).
# Local-only stacks can keep http.
APP_SCHEME=https

# Optional edge ports
# HTTP_PORT=80
# HTTPS_PORT=443

# Secure cookies when APP_SCHEME=https (set false only for plain-HTTP lab).
# ANUBIS_COOKIE_SECURE=true
# NEXUS_OAUTH2_COOKIE_SECURE=true

# Postgres superuser (infrastructure only; not an app login).
POSTGRES_PASSWORD=change-me-postgres

# Single app admin (Authelia / Nextcloud / Nexus)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin

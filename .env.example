# Apex domain. Subdomains: auth./kiwix./cloud./nexus./www.<DOMAIN>
# Local browser hosts (*.localhost -> loopback): DOMAIN=localhost
DOMAIN=example.com

# Public URL scheme used in OIDC redirects / discovery (http for local, https in prod).
APP_SCHEME=http

# Shared Postgres superuser (service name: postgres).
# App services get their own DB + role via postgres/init or scripts/pg-app-db.sh.
POSTGRES_PASSWORD=change-me-postgres-superuser

# Optional override. Default: ${APP_SCHEME}://auth.<DOMAIN>
# KEYCLOAK_HOSTNAME=http://auth.example.com

# Bootstrap admin for Keycloak master realm (only applied on first empty DB).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-now

# Keycloak app role/db on shared postgres (db=keycloak user=keycloak).
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# Keycloak application realm + OIDC clients (auto-created on Keycloak start).
# Login with Keycloak uses KEYCLOAK_ADMIN / KEYCLOAK_ADMIN_PASSWORD.
KEYCLOAK_REALM=home
OIDC_CLIENT_ID=nextcloud
OIDC_CLIENT_SECRET=change-me-oidc-client-secret

# Nextcloud on cloud.<DOMAIN> (db=nextcloud user=nextcloud).
# Local admin still works alongside OIDC.
NEXTCLOUD_DB_PASSWORD=change-me-nextcloud-db
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me-nextcloud-admin

# Nexus Repository Manager on nexus.<DOMAIN>/
# UI login is Keycloak SSO (oauth2-proxy). Local admin password is for REST/API.
# Username must match KEYCLOAK_ADMIN so SSO maps to the nx-admin account.
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=change-me-nexus-admin
NEXUS_OIDC_CLIENT_ID=nexus
NEXUS_OIDC_CLIENT_SECRET=change-me-nexus-oidc-client-secret
# 16/24/32 bytes, base64 (openssl rand -base64 24)
NEXUS_OAUTH2_COOKIE_SECRET=change-me-nexus-oauth2-cookie-secret
# true when APP_SCHEME=https
NEXUS_OAUTH2_COOKIE_SECURE=false

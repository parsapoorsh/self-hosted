# Public URL Keycloak advertises in tokens / redirects (include /auth path).
# Change this when you put a real domain in front of nginx.
KEYCLOAK_HOSTNAME=https://localhost/auth

# Bootstrap admin (only applied on first empty DB start).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-now

# Postgres password for the keycloak DB user.
KEYCLOAK_DB_PASSWORD=change-me-db-password

# Host-wide settings and secrets only.
# Per-service constants live next to each service as `env` or `*.env`
# (see nginx/env, keycloak/env, nexus/env, nexus/oauth2-*.env, …).

# Apex domain. Subdomains: auth./kiwix./cloud./nexus./www.<DOMAIN>
# Local: one cert for the whole localhost tree (cert/localhost, SAN=*.localhost).
# Trust the CA once so the browser stops warning on every subdomain:
#   ./scripts/gen-localhost-cert.sh && ./scripts/trust-localhost-ca.sh
DOMAIN=example.com


# Public URL scheme for OIDC redirects (http local, https prod).
APP_SCHEME=http

# Optional edge ports
# HTTP_PORT=80
# HTTPS_PORT=443

# Shared Postgres superuser
POSTGRES_PASSWORD=change-me-postgres-superuser

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-now
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
KEYCLOAK_REALM=home
# Optional fixed frontend URL (default: request Host / X-Forwarded-Host)
# KEYCLOAK_HOSTNAME=http://auth.example.com

# Nextcloud OIDC client (created by keycloak bootstrap)
OIDC_CLIENT_ID=nextcloud
OIDC_CLIENT_SECRET=change-me-oidc-client-secret

# Nextcloud
NEXTCLOUD_DB_PASSWORD=change-me-nextcloud-db
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me-nextcloud-admin

# Nexus (UI SSO via Keycloak; API basic auth uses NEXUS_ADMIN_*)
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=change-me-nexus-admin
NEXUS_OIDC_CLIENT_ID=nexus
NEXUS_OIDC_CLIENT_SECRET=change-me-nexus-oidc-client-secret
# 16/24/32 bytes base64: openssl rand -base64 24
NEXUS_OAUTH2_COOKIE_SECRET=change-me-nexus-oauth2-cookie-secret
# true when APP_SCHEME=https (DOMAIN oauth2-proxy only; localhost proxy is always secure)
NEXUS_OAUTH2_COOKIE_SECURE=false

# Optional Anubis
# ANUBIS_COOKIE_SECURE=true
